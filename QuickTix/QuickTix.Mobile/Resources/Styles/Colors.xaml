<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Azul elegante (base) -->
    <!-- Primary: azul medio profesional -->
    <Color x:Key="Primary">#2F6FED</Color>
    <!-- PrimaryDark: azul más profundo para estados/hover/dark bindings -->
    <Color x:Key="PrimaryDark">#1E4DB7</Color>
    <!-- Texto sobre PrimaryDark en tu Styles.xaml -->
    <Color x:Key="PrimaryDarkText">#0B1220</Color>

    <!-- Secondary: azul muy claro para superficies alternativas -->
    <Color x:Key="Secondary">#E7F0FF</Color>
    <Color x:Key="SecondaryDarkText">#0B1220</Color>

    <!-- Tertiary: cian sobrio como acento -->
    <Color x:Key="Tertiary">#22B8CF</Color>

    <!-- Neutrales base -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Ajustes del template (evitamos magenta; lo alineamos con azul) -->
    <Color x:Key="Magenta">#2F6FED</Color>
    <Color x:Key="MidnightBlue">#0B1220</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <!-- Grises (más modernos, estilo slate) -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#0B1220</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!-- Alias para pantallas nuevas -->
    <Color x:Key="PrimaryColor">#2F6FED</Color>
    <Color x:Key="PrimaryOnColor">#FFFFFF</Color>

    <Color x:Key="SecondaryColor">#1E4DB7</Color>
    <Color x:Key="InfoColor">#22B8CF</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>

    <!-- Acento elegante (lavender muy suave) -->
    <Color x:Key="AccentColor">#B9C6FF</Color>

    <!-- Fondos y superficies -->
    <Color x:Key="PageBackgroundColor">#F6F8FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#D9E2F2</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#0B1220</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>

    <!-- Estados -->
    <Color x:Key="DangerColor">#DC2626</Color>

</ResourceDictionary>
