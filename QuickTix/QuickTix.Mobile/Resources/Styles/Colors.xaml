<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================
         Tema "1b Vibra" — tokens de color del handoff de diseño
         (reference/App redesign directions/design_handoff_quicktix_vibra).
         Las claves heredadas de la plantilla se conservan (remapeadas
         a la paleta Vibra) para no romper Static/DynamicResource.
         ============================================================ -->

    <!-- ===== Tokens Vibra: marca ===== -->
    <Color x:Key="BrandTeal">#60E0CF</Color>
    <Color x:Key="BrandTealDeep">#3CC9C0</Color>
    <Color x:Key="BrandCyan">#60C7E0</Color>
    <Color x:Key="BrandPeriwinkle">#7C9BF7</Color>
    <Color x:Key="BrandLavender">#CCAFEB</Color>
    <Color x:Key="BrandSky">#ABD6FF</Color>

    <!-- ===== Tokens Vibra: texto ===== -->
    <Color x:Key="Ink">#14233B</Color>
    <Color x:Key="InkSidebar">#0F1B33</Color>
    <Color x:Key="TitleBar">#14233B</Color>
    <Color x:Key="TextMuted">#8393AC</Color>
    <Color x:Key="TextMuted2">#4A5163</Color>

    <!-- ===== Tokens Vibra: fondos y superficies ===== -->
    <Color x:Key="PageBg">#F2F6FF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#FAFCFF</Color>
    <Color x:Key="TableHeadBg">#F7F9FE</Color>
    <Color x:Key="Border">#E7ECF7</Color>
    <Color x:Key="BorderStrong">#DCE6FF</Color>

    <!-- ===== Tokens Vibra: chips ===== -->
    <Color x:Key="ChipBlueBg">#EEF3FF</Color>
    <Color x:Key="ChipBlueFg">#4E67C7</Color>
    <Color x:Key="ChipTealBg">#EAFBF8</Color>
    <Color x:Key="ChipTealFg">#0F8C82</Color>
    <Color x:Key="ChipLavBg">#F4F1FC</Color>
    <Color x:Key="ChipLavFg">#7A5CB0</Color>

    <!-- ===== Tokens Vibra: estados ===== -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessBg">#EAFBF8</Color>
    <Color x:Key="DangerBg">#F1EAF0</Color>
    <Color x:Key="DangerFg">#B0447A</Color>
    <Color x:Key="ExpiredBg">#F1F0F3</Color>
    <Color x:Key="ExpiredFg">#9098A8</Color>
    <Color x:Key="ExpiredCard1">#B4BAC4</Color>
    <Color x:Key="ExpiredCard2">#9CA3AF</Color>
    <!-- Botón deshabilitado (sección Interactions del handoff) -->
    <Color x:Key="DisabledBg">#EEF0F6</Color>
    <Color x:Key="DisabledText">#8393AC</Color>

    <!-- ===== Tokens Vibra: tonos intermedios de tarjeta por categoría =====
         Mapeo compartido con los chips de Desktop:
         Adulto = teal (CardGradient), Niño = sky, Jubilado = lavanda,
         FamiliaNumerosa = periwinkle. Los tonos sky van ligeramente más
         oscuros que BrandSky (#ABD6FF) para que el texto blanco siga
         siendo legible sobre la variante más clara. -->
    <Color x:Key="CardSky1">#9CCBFF</Color>
    <Color x:Key="CardSky2">#89B4FA</Color>
    <Color x:Key="CardLavMid">#B8A5F0</Color>
    <Color x:Key="CardBlueMid">#6E8BE8</Color>

    <!-- ===== Brushes de los tokens Vibra ===== -->
    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTeal}" />
    <SolidColorBrush x:Key="BrandTealDeepBrush" Color="{StaticResource BrandTealDeep}" />
    <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyan}" />
    <SolidColorBrush x:Key="BrandPeriwinkleBrush" Color="{StaticResource BrandPeriwinkle}" />
    <SolidColorBrush x:Key="BrandLavenderBrush" Color="{StaticResource BrandLavender}" />
    <SolidColorBrush x:Key="BrandSkyBrush" Color="{StaticResource BrandSky}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="InkSidebarBrush" Color="{StaticResource InkSidebar}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBar}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextMuted2Brush" Color="{StaticResource TextMuted2}" />
    <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}" />
    <SolidColorBrush x:Key="TableHeadBgBrush" Color="{StaticResource TableHeadBg}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="ChipBlueBgBrush" Color="{StaticResource ChipBlueBg}" />
    <SolidColorBrush x:Key="ChipBlueFgBrush" Color="{StaticResource ChipBlueFg}" />
    <SolidColorBrush x:Key="ChipTealBgBrush" Color="{StaticResource ChipTealBg}" />
    <SolidColorBrush x:Key="ChipTealFgBrush" Color="{StaticResource ChipTealFg}" />
    <SolidColorBrush x:Key="ChipLavBgBrush" Color="{StaticResource ChipLavBg}" />
    <SolidColorBrush x:Key="ChipLavFgBrush" Color="{StaticResource ChipLavFg}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBg}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBg}" />
    <SolidColorBrush x:Key="DangerFgBrush" Color="{StaticResource DangerFg}" />
    <SolidColorBrush x:Key="ExpiredBgBrush" Color="{StaticResource ExpiredBg}" />
    <SolidColorBrush x:Key="ExpiredFgBrush" Color="{StaticResource ExpiredFg}" />
    <SolidColorBrush x:Key="DisabledBgBrush" Color="{StaticResource DisabledBg}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledText}" />

    <!-- ===== Degradados Vibra =====
         Conversión de ángulos CSS: 90deg = horizontal izq→der
         (StartPoint 0,0.5 → EndPoint 1,0.5); 150deg ≈ diagonal desde
         arriba-izquierda (vector 0.5,0.866 → EndPoint 0.58,1). -->
    <LinearGradientBrush x:Key="ActionGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BrandTealDeep}" Offset="0" />
        <GradientStop Color="{StaticResource BrandCyan}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActionGradientAlt" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="0" />
        <GradientStop Color="{StaticResource BrandCyan}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource BrandTeal}" Offset="0" />
        <GradientStop Color="{StaticResource BrandCyan}" Offset="0.45" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource BrandTeal}" Offset="0" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ChipNewGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BrandTealDeep}" Offset="0" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ExpiredCardGradient" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource ExpiredCard1}" Offset="0" />
        <GradientStop Color="{StaticResource ExpiredCard2}" Offset="1" />
    </LinearGradientBrush>

    <!-- Degradados de tarjeta de abono por categoría (150deg, misma geometría
         que CardGradient). Adulto conserva CardGradient (teal→periwinkle). -->
    <!-- Niño: familia sky -->
    <LinearGradientBrush x:Key="CardGradientSky" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource CardSky1}" Offset="0" />
        <GradientStop Color="{StaticResource CardSky2}" Offset="0.45" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <!-- Jubilado: familia lavanda -->
    <LinearGradientBrush x:Key="CardGradientLavender" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource BrandLavender}" Offset="0" />
        <GradientStop Color="{StaticResource CardLavMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <!-- Familia numerosa: familia periwinkle/azul -->
    <LinearGradientBrush x:Key="CardGradientPeriwinkle" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="0" />
        <GradientStop Color="{StaticResource CardBlueMid}" Offset="0.45" />
        <GradientStop Color="{StaticResource BrandCyan}" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================
         Claves heredadas de la plantilla, remapeadas a Vibra.
         NO renombrar ni eliminar: las consumen páginas y Styles.xaml.
         ============================================================ -->

    <!-- Primary: periwinkle (acción/interactivo de la paleta Vibra) -->
    <Color x:Key="Primary">#7C9BF7</Color>
    <!-- PrimaryDark: periwinkle profundo (ChipBlueFg) para estados/hover -->
    <Color x:Key="PrimaryDark">#4E67C7</Color>
    <!-- Texto sobre PrimaryDark -->
    <Color x:Key="PrimaryDarkText">#0A2233</Color>

    <!-- Secondary: azul muy claro (ChipBlueBg) para superficies alternativas -->
    <Color x:Key="Secondary">#EEF3FF</Color>
    <Color x:Key="SecondaryDarkText">#14233B</Color>

    <!-- Tertiary: cyan de marca -->
    <Color x:Key="Tertiary">#60C7E0</Color>

    <!-- Neutrales base -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Acento de la TabBar (antes "Magenta" en la plantilla; nunca fue magenta) -->
    <Color x:Key="TabBarAccent">#7C9BF7</Color>
    <Color x:Key="MidnightBlue">#14233B</Color>
    <Color x:Key="OffBlack">#0F1B33</Color>

    <!-- Grises (slate, se conservan tal cual) -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#0B1220</Color>

    <!-- Brushes heredados -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!-- Alias para pantallas nuevas (remapeados a Vibra) -->
    <Color x:Key="PrimaryColor">#7C9BF7</Color>
    <Color x:Key="PrimaryOnColor">#FFFFFF</Color>

    <Color x:Key="SecondaryColor">#4E67C7</Color>
    <Color x:Key="InfoColor">#60C7E0</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>

    <!-- Acento terciario (lavanda de marca) -->
    <Color x:Key="AccentColor">#CCAFEB</Color>

    <!-- Fondos y superficies -->
    <Color x:Key="PageBackgroundColor">#F2F6FF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#E7ECF7</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#14233B</Color>
    <Color x:Key="TextSecondaryColor">#8393AC</Color>

    <!-- Estados -->
    <Color x:Key="DangerColor">#B0447A</Color>

</ResourceDictionary>
