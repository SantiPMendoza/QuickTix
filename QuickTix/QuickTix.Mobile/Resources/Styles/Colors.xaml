<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta QuickTix -->
    <!-- #60E0CF  #609FE0  #60C7E0  #CCAFEB  #7C9BF7  #ABD6FF -->

    <!-- Keys esperadas por Styles.xaml (compatibilidad) -->
    <Color x:Key="Primary">#7C9BF7</Color>
    <Color x:Key="PrimaryDark">#609FE0</Color>
    <Color x:Key="PrimaryDarkText">#111827</Color>

    <Color x:Key="Secondary">#60C7E0</Color>
    <Color x:Key="SecondaryDarkText">#111827</Color>

    <Color x:Key="Tertiary">#60E0CF</Color>

    <!-- Neutrales base -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Ajustes visuales del template (antes Magenta/MidnightBlue) -->
    <Color x:Key="Magenta">#609FE0</Color>
    <Color x:Key="MidnightBlue">#111827</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!-- Escala de grises (puedes mantenerlos tal cual; no dependen de la paleta) -->
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes (siguen siendo útiles para controles que esperen Brush) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!-- Alias para tus pantallas nuevas (TicketsPage y futuras) -->
    <Color x:Key="PrimaryColor">#7C9BF7</Color>
    <Color x:Key="PrimaryOnColor">#FFFFFF</Color>

    <Color x:Key="SecondaryColor">#609FE0</Color>
    <Color x:Key="InfoColor">#60C7E0</Color>
    <Color x:Key="SuccessColor">#60E0CF</Color>
    <Color x:Key="AccentColor">#CCAFEB</Color>

    <Color x:Key="PageBackgroundColor">#ABD6FF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#CCAFEB</Color>

    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>

    <Color x:Key="DangerColor">#DC2626</Color>

</ResourceDictionary>
