<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuickTix.Mobile.ViewModels"
             x:Class="QuickTix.Mobile.Views.SubscriptionsPage"
             x:DataType="vm:SubscriptionsViewModel"
             Title="Abonos"
             BackgroundColor="{StaticResource PageBg}">

    <ContentPage.Resources>
        <!-- Texto oscuro sobre degradado de marca (handoff 2a: chip #0A2233) -->
        <Color x:Key="OnGradientInk">#0A2233</Color>
        <!-- Chip de estado ACTIVO: blanco al 40% sobre el degradado -->
        <Color x:Key="ChipOverlayColor">#66FFFFFF</Color>
        <!-- Texto secundario sobre tarjeta degradada -->
        <Color x:Key="CardMutedOnColor">#EDEDED</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Padding="16"
          RowSpacing="12">

        <!-- Cabecera: título + avatar de marca (no hay propiedad de nombre a nivel
             de página, así que el avatar lleva el logo en vez de iniciales) -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,4,0,0">
            <Label Text="Mis abonos"
                   FontFamily="SpaceGroteskBold"
                   FontSize="24"
                   CharacterSpacing="-0.5"
                   TextColor="{StaticResource Ink}"
                   VerticalOptions="Center" />
            <Border Grid.Column="1"
                    Background="{StaticResource AvatarGradient}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="8">
                <Image Source="vibra_logo.png" Aspect="AspectFit" />
            </Border>
        </Grid>

        <CarouselView Grid.Row="1"
                      ItemsSource="{Binding Subscriptions}"
                      CurrentItem="{Binding SelectedSubscription}"
                      IndicatorView="subscriptionsIndicator"
                      PeekAreaInsets="40"
                      IsBounceEnabled="True">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:SubscriptionCardViewModel">
                    <Border StrokeShape="RoundRectangle 26"
                            Padding="0"
                            Margin="8,12"
                            StrokeThickness="0"
                            Background="{StaticResource CardGradient}">

                        <Border.Shadow>
                            <!-- Sombra de color del handoff: rgba(96,150,224,.6) suavizada -->
                            <Shadow Brush="{StaticResource BrandPeriwinkleBrush}"
                                    Opacity="0.45"
                                    Radius="34"
                                    Offset="0,14" />
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto,*,Auto"
                              Padding="22,20">

                            <Grid Grid.Row="0"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12">

                                <!-- Chip de estado: pill blanca .4 (activa) / gris (caducada) -->
                                <Border StrokeShape="RoundRectangle 20"
                                        StrokeThickness="0"
                                        Padding="12,6"
                                        BackgroundColor="{StaticResource ChipOverlayColor}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsExpired}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{StaticResource ExpiredBg}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding StatusText}"
                                           TextColor="{StaticResource OnGradientInk}"
                                           FontFamily="DMSansBold"
                                           FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsExpired}"
                                                         Value="True">
                                                <Setter Property="TextColor"
                                                        Value="{StaticResource ExpiredFg}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding SubscriptionTitle}"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontFamily="SpaceGrotesk"
                                       FontSize="17"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                            </Grid>

                            <!-- Cuerpo: cliente + datos clave -->
                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="6"
                                  Margin="0,18,0,18">

                                <Label Text="Abonado"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontFamily="DMSansSemiBold"
                                       FontSize="13"
                                       Opacity="0.85" />

                                <Label Grid.Row="1"
                                       Text="{Binding ClientName}"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontFamily="SpaceGroteskBold"
                                       FontSize="26"
                                       CharacterSpacing="-0.5"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="2"
                                       Text="{Binding SubscriptionSubtitle}"
                                       TextColor="{StaticResource CardMutedOnColor}"
                                       FontFamily="DMSansSemiBold"
                                       FontSize="14"
                                       Margin="0,6,0,0"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="3"
                                       Text="{Binding ValidityText}"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontFamily="DMSansBold"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />
                            </Grid>

                            <!-- Footer: referencia mono + logo pequeño -->
                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,Auto"
                                  VerticalOptions="End">

                                <Label Text="{Binding ReferenceText}"
                                       TextColor="{StaticResource CardMutedOnColor}"
                                       FontFamily="PlexMono"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />

                                <Image Grid.Column="1"
                                       Source="vibra_logo.png"
                                       WidthRequest="26"
                                       HeightRequest="26"
                                       Opacity="0.9" />
                            </Grid>

                        </Grid>

                        <!-- Color por categoría (mismo mapeo que los chips de Desktop):
                             Adulto = teal (CardGradient por defecto, sin trigger),
                             Niño = sky, Jubilado = lavanda, FamiliaNumerosa = periwinkle. -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding CategoryKey}"
                                         Value="Nino">
                                <Setter Property="Background"
                                        Value="{StaticResource CardGradientSky}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding CategoryKey}"
                                         Value="Jubilado">
                                <Setter Property="Background"
                                        Value="{StaticResource CardGradientLavender}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding CategoryKey}"
                                         Value="FamiliaNumerosa">
                                <Setter Property="Background"
                                        Value="{StaticResource CardGradientPeriwinkle}" />
                            </DataTrigger>
                            <!-- Estado caducada (2f): SIEMPRE el último trigger — en MAUI
                                 el trigger posterior gana, así el gris pisa al color de categoría. -->
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsExpired}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource ExpiredCardGradient}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Indicador 2a: punto activo alargado 18×6 periwinkle, inactivos 6×6 -->
        <IndicatorView x:Name="subscriptionsIndicator"
                       Grid.Row="2"
                       HorizontalOptions="Center"
                       Margin="0,0,0,6">
            <IndicatorView.IndicatorTemplate>
                <DataTemplate>
                    <BoxView WidthRequest="6"
                             HeightRequest="6"
                             CornerRadius="3"
                             Margin="3,0"
                             Color="#C7D2F0"
                             VerticalOptions="Center">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="WidthRequest" Value="6" />
                                            <Setter Property="Color" Value="#C7D2F0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="WidthRequest" Value="18" />
                                            <Setter Property="Color" Value="{StaticResource BrandPeriwinkle}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </BoxView>
                </DataTemplate>
            </IndicatorView.IndicatorTemplate>
        </IndicatorView>

        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource DangerFg}"
               FontFamily="DMSans"
               FontSize="12"
               Margin="0,8,0,0" />
    </Grid>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cerrar sesión"
                 Priority="0"
                 Order="Primary"
                 Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

</ContentPage>
