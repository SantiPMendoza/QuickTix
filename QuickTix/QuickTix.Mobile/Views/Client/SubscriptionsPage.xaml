<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuickTix.Mobile.ViewModels"
             x:Class="QuickTix.Mobile.Views.SubscriptionsPage"
             x:DataType="vm:SubscriptionsViewModel"
             Title="Abonos"
             BackgroundColor="{DynamicResource PageBackgroundColor}"
             Visual="Material">

    <ContentPage.Resources>
        <Color x:Key="ChipOverlayColor">#33000000</Color>
        <Color x:Key="CardMutedOnColor">#EDEDED</Color>

        <Color x:Key="ExpiredCardColor">#9CA3AF</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto,Auto"
          Padding="16"
          RowSpacing="12">

        <CarouselView Grid.Row="0"
                      ItemsSource="{Binding Subscriptions}"
                      CurrentItem="{Binding SelectedSubscription}"
                      IndicatorView="subscriptionsIndicator"
                      PeekAreaInsets="40"
                      IsBounceEnabled="True">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:SubscriptionCardViewModel">
                    <Border StrokeShape="RoundRectangle 24"
                            Padding="0"
                            Margin="8"
                            BackgroundColor="{Binding CardColor}"
                            Stroke="{DynamicResource CardBorderColor}">

                        <Border.Shadow>
                            <Shadow Opacity="0.25"
                                    Radius="18"
                                    Offset="0,8" />
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto,*,Auto"
                              Padding="20">

                            <Grid Grid.Row="0"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12">

                                <Border StrokeShape="RoundRectangle 16"
                                        Padding="10,6"
                                        BackgroundColor="{StaticResource ChipOverlayColor}">
                                    <Label Text="{Binding StatusText}"
                                           TextColor="{DynamicResource PrimaryOnColor}"
                                           FontAttributes="Bold"
                                           FontSize="14" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding SubscriptionTitle}"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                            </Grid>

                            <!-- Cuerpo: cliente + datos clave -->
                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="10"
                                  Margin="0,18,0,18">

                                <Label Text="{Binding ClientName}"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="1"
                                       Text="{Binding SubscriptionSubtitle}"
                                       TextColor="{StaticResource CardMutedOnColor}"
                                       FontSize="16"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="2"
                                       Text="{Binding ValidityText}"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                            </Grid>

                            <!-- Footer: código / id / notas -->
                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,Auto"
                                  VerticalOptions="End">

                                <Label Text="{Binding ReferenceText}"
                                       TextColor="{StaticResource CardMutedOnColor}"
                                       FontSize="14"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Column="1"
                                       Text="CADUCADA"
                                       IsVisible="{Binding IsExpired}"
                                       TextColor="{DynamicResource PrimaryOnColor}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       Opacity="0.85" />
                            </Grid>

                        </Grid>

                        <!-- Estado caducada: forzamos un gris elegante y coherente -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsExpired}"
                                         Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{StaticResource ExpiredCardColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="subscriptionsIndicator"
                       Grid.Row="1"
                       HorizontalOptions="Center"
                       IndicatorSize="8"
                       Margin="0,0,0,6" />

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{DynamicResource DangerColor}"
               FontSize="12"
               Margin="0,8,0,0" />
    </Grid>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cerrar sesión"
                 Priority="0"
                 Order="Primary"
                 Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

</ContentPage>
