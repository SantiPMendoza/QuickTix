<UserControl x:Class="QuickTix.Desktop.Controls.VibraDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             x:Name="RootDialog">

    <!-- Componente modal común del tema Vibra (fix pruebas manuales 2b).
         Chrome compartido de todos los popups de formulario: Popup centrado,
         tarjeta VibraPopupCard con sombra elevada, título display y áreas de
         contenido y botones. Las vistas solo aportan DialogContent y Footer;
         los bindings del formulario se resuelven contra el DataContext
         heredado de la página (el UserControl no fija DataContext propio). -->

    <Popup IsOpen="{Binding IsOpen, ElementName=RootDialog, Mode=TwoWay}"
           StaysOpen="True"
           Placement="Center"
           AllowsTransparency="True">
        <!-- Margen exterior para que la sombra elevada no se recorte -->
        <Grid Margin="32">
            <!-- Relieve del modal: sombra propia (DialogShadow, un punto más
                 que ElevatedShadow) + brillo sutil en el borde superior.
                 Overrides locales: VibraPopupCard sigue igual para otros usos. -->
            <Border Style="{StaticResource VibraPopupCard}"
                    Effect="{StaticResource DialogShadow}"
                    BorderBrush="{StaticResource DialogCardBorderBrush}"
                    MinWidth="{Binding DialogMinWidth, ElementName=RootDialog}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera: título Vibra + botón de cierre opcional
                         (visible solo si la vista aporta CloseCommand) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Title, ElementName=RootDialog}"
                                   Style="{StaticResource VibraPopupTitle}"/>

                        <Button Grid.Column="1"
                                Command="{Binding CloseCommand, ElementName=RootDialog}"
                                Visibility="{Binding CloseCommand, ElementName=RootDialog,
                                             Converter={StaticResource NullToCollapsedVisibilityConverter}}"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                Padding="6,2"
                                Background="Transparent"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource SurfaceAltBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <!-- SymbolIcon directo (ruta nativa de WPF-UI): el glifo por
                                 TextBlock+FluentSystemIcons no renderizaba en runtime -->
                            <ui:SymbolIcon Symbol="Dismiss24"
                                           FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Contenido del formulario aportado por la vista -->
                    <ContentControl Grid.Row="1"
                                    Focusable="False"
                                    HorizontalContentAlignment="Stretch"
                                    Content="{Binding DialogContent, ElementName=RootDialog}"/>

                    <!-- Botonera aportada por la vista (el chrome ya alinea a la derecha) -->
                    <ContentControl Grid.Row="2"
                                    Focusable="False"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Right"
                                    Content="{Binding Footer, ElementName=RootDialog}"/>
                </Grid>
            </Border>
        </Grid>
    </Popup>
</UserControl>
