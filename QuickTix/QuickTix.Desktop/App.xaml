<Application x:Class="QuickTix.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickTix.Desktop"
             xmlns:conv="clr-namespace:QuickTix.Desktop.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             DispatcherUnhandledException="OnDispatcherUnhandledException"
             Exit="OnExit"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- Tema Vibra: siempre DESPUÉS de los diccionarios de WPF-UI
                     para que sus tokens ganen en caso de clave repetida -->
                <ResourceDictionary Source="pack://application:,,,/Themes/VibraTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters globales -->
            <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
            <conv:BoolToTextConverter x:Key="BoolToTextConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:NullToCollapsedVisibilityConverter x:Key="NullToCollapsedVisibilityConverter" />
            <conv:InitialsConverter x:Key="InitialsConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
