<Page x:Class="QuickTix.Desktop.Views.Pages.CashCloseView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="1000"
      Title="CashCloseView">

    <!-- Cierre de caja (arqueo), solo admin. Página de solo lectura como el Panel:
         el ViewModel entrega todo ya formateado (es-ES) y el XAML solo pinta. -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Cabecera de sección dentro de una tarjeta -->
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource VibraCardTitle}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBgBrush}"
          TextElement.FontFamily="{StaticResource VibraBodyFontFamily}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topbar de página -->
        <Border Grid.Row="0" Style="{StaticResource VibraTopBar}">
            <Grid>
                <TextBlock Style="{StaticResource VibraPageTitle}" Text="Cierre de caja" />
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="22" Height="22"
                                 HorizontalAlignment="Right"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">

                <!-- Error inline -->
                <Border Background="{StaticResource DangerBgBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="14,10" Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerFgBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Aviso inline de exportación correcta -->
                <Border Background="{StaticResource SuccessBgBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="14,10" Margin="0,0,0,14"
                        Visibility="{Binding ExportMessage, Converter={StaticResource NullToCollapsedVisibilityConverter}}">
                    <TextBlock Text="{Binding ExportMessage}"
                               Foreground="{StaticResource ChipTealFgBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <!-- ===== Filtros ===== -->
                <Border Style="{StaticResource VibraCard}" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <Label Content="Desde:" Style="{StaticResource VibraFieldLabel}" Margin="0,0,0,4" />
                            <DatePicker Width="160"
                                        SelectedDate="{Binding FromDate}"
                                        Language="es-ES" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0">
                            <Label Content="Hasta:" Style="{StaticResource VibraFieldLabel}" Margin="0,0,0,4" />
                            <DatePicker Width="160"
                                        SelectedDate="{Binding ToDate}"
                                        Language="es-ES" />
                        </StackPanel>
                        <Button Content="Consultar" Width="120" VerticalAlignment="Bottom"
                                Style="{StaticResource VibraPrimaryButton}"
                                Command="{Binding LoadCommand}" />
                        <Button Content="Exportar CSV" Width="130" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                Style="{StaticResource VibraSecondaryButton}"
                                Command="{Binding ExportCsvCommand}" />
                    </StackPanel>
                </Border>

                <!-- ===== Resultados ===== -->
                <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Margin="2,0,0,10"
                               Foreground="{StaticResource TextMuted2Brush}"
                               FontWeight="SemiBold">
                        <Run Text="Periodo:" />
                        <Run Text="{Binding RangeText, Mode=OneWay}" />
                    </TextBlock>

                    <!-- KPIs: las anuladas NO suman en el total -->
                    <UniformGrid Columns="4" Margin="-7,0,-7,14">
                        <Border Style="{StaticResource VibraCard}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VibraKpiLabel}" Text="Total cobrado" />
                                <TextBlock Style="{StaticResource VibraKpiValue}" Text="{Binding TotalText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VibraCard}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VibraKpiLabel}" Text="Nº de ventas" />
                                <TextBlock Style="{StaticResource VibraKpiValue}" Text="{Binding SaleCountText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VibraCard}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VibraKpiLabel}" Text="Anulado (no suma)" />
                                <TextBlock Style="{StaticResource VibraKpiValue}" Text="{Binding VoidedTotalText}"
                                           Foreground="{StaticResource DangerFgBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VibraCard}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VibraKpiLabel}" Text="Ventas anuladas" />
                                <TextBlock Style="{StaticResource VibraKpiValue}" Text="{Binding VoidedCountText}"
                                           Foreground="{StaticResource DangerFgBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Desglose recinto → vendedor -->
                    <Border Style="{StaticResource VibraCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Por recinto y vendedor" />
                            <ItemsControl ItemsSource="{Binding Venues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="{Binding VenueName}" FontWeight="Bold"
                                                           Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="{Binding TotalText}" FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Sellers}" Margin="16,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SellerName}"
                                                                       Foreground="{StaticResource TextMuted2Brush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SalesText}"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}"
                                                                       TextAlignment="Right"
                                                                       Foreground="{StaticResource InkBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Por concepto + por medio de pago, lado a lado -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource VibraCard}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Por concepto" />
                                <ListView ItemsSource="{Binding Concepts}"
                                          Style="{StaticResource VibraTableListView}"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                            <GridViewColumn Header="CONCEPTO" Width="230" DisplayMemberBinding="{Binding Concept}" />
                                            <GridViewColumn Header="CANTIDAD" Width="90" DisplayMemberBinding="{Binding Quantity}" />
                                            <GridViewColumn Header="TOTAL" Width="110"
                                                            HeaderContainerStyle="{StaticResource VibraTableHeaderRight}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TotalText}" TextAlignment="Right"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource VibraCard}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Por medio de pago" />
                                <ListView ItemsSource="{Binding PaymentMethods}"
                                          Style="{StaticResource VibraTableListView}"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                            <GridViewColumn Header="MEDIO" Width="130" DisplayMemberBinding="{Binding MethodName}" />
                                            <GridViewColumn Header="TOTAL" Width="110"
                                                            HeaderContainerStyle="{StaticResource VibraTableHeaderRight}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TotalText}" TextAlignment="Right"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Líneas de venta (solo cobradas) -->
                    <Border Style="{StaticResource VibraCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Líneas de venta" />
                            <ListView ItemsSource="{Binding Lines}"
                                      MaxHeight="360"
                                      Style="{StaticResource VibraTableListView}"
                                      HorizontalContentAlignment="Stretch">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                        <GridViewColumn Header="FECHA" Width="130" DisplayMemberBinding="{Binding DateText}" />
                                        <GridViewColumn Header="RECINTO" Width="140" DisplayMemberBinding="{Binding VenueName}" />
                                        <GridViewColumn Header="VENDEDOR" Width="150" DisplayMemberBinding="{Binding SellerName}" />
                                        <GridViewColumn Header="CONCEPTO" Width="200" DisplayMemberBinding="{Binding Concept}" />
                                        <GridViewColumn Header="CANT." Width="60" DisplayMemberBinding="{Binding Quantity}" />
                                        <GridViewColumn Header="PRECIO" Width="100" DisplayMemberBinding="{Binding UnitPriceText}" />
                                        <GridViewColumn Header="SUBTOTAL" Width="110"
                                                        HeaderContainerStyle="{StaticResource VibraTableHeaderRight}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SubtotalText}" TextAlignment="Right"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource InkBrush}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="MEDIO" Width="90" DisplayMemberBinding="{Binding PaymentText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Ventas anuladas: aparte y fuera de todos los totales -->
                    <Border Style="{StaticResource VibraCard}" Margin="0,0,0,14"
                            Visibility="{Binding HasVoidedLines, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Ventas anuladas (no suman en el total)" />
                            <ListView ItemsSource="{Binding VoidedLines}"
                                      MaxHeight="300"
                                      Style="{StaticResource VibraTableListView}"
                                      HorizontalContentAlignment="Stretch">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                        <GridViewColumn Header="FECHA" Width="130" DisplayMemberBinding="{Binding DateText}" />
                                        <GridViewColumn Header="RECINTO" Width="140" DisplayMemberBinding="{Binding VenueName}" />
                                        <GridViewColumn Header="VENDEDOR" Width="150" DisplayMemberBinding="{Binding SellerName}" />
                                        <GridViewColumn Header="CONCEPTO" Width="180" DisplayMemberBinding="{Binding Concept}" />
                                        <GridViewColumn Header="SUBTOTAL" Width="110" DisplayMemberBinding="{Binding SubtotalText}" />
                                        <GridViewColumn Header="MOTIVO" Width="300">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding VoidReason}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource DangerFgBrush}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
