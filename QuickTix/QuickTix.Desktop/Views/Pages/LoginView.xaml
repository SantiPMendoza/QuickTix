<Page x:Class="QuickTix.Desktop.Views.Pages.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:QuickTix.Desktop.Views.Pages"
      xmlns:controls="clr-namespace:QuickTix.Desktop.Controls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:LoginView, IsDesignTimeCreatable=True}"
      Title="Inicio de Sesión"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="White">
    


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="1" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <TextBlock Text="Inicio de Sesión" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="20"/>

            <ui:TextBox PlaceholderText="Nombre de usuario" x:Name="UserNameText"
                        Text="{Binding ViewModel.Username, UpdateSourceTrigger=PropertyChanged}"
                Height="40" Cursor="IBeam">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Mail24"/>
                </ui:TextBox.Icon>
            </ui:TextBox>

            <ui:PasswordBox PlaceholderText="Contraseña" x:Name="PasswordText"
                            Password="{Binding ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Height="40">
                <ui:PasswordBox.Icon>
                    <ui:SymbolIcon Symbol="Key24"/>
                </ui:PasswordBox.Icon>
            </ui:PasswordBox>

            <CheckBox 
    Content="Recordar usuario"
    IsChecked="{Binding ViewModel.RememberUser, Mode=TwoWay}"
    Margin="0,10,0,0"/>


            <ui:Button Content="Iniciar Sesión"
               Command="{Binding ViewModel.CheckLoginCommand, Mode=OneWay}"
               Height="45"
               HorizontalAlignment="Center"
               Appearance="Primary"/>


        </StackPanel>

        <!-- Aviso modal del login (sustituye a los MessageBox). Tras el aviso
             de bienvenida, CloseAlert navega al Panel. -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="3"
                              IsOpen="{Binding ViewModel.IsAlertOpen}"
                              DialogMinWidth="380"
                              Title="{Binding ViewModel.AlertTitle}">
            <controls:VibraDialog.DialogContent>
                <TextBlock Text="{Binding ViewModel.AlertMessage}"
                           MaxWidth="440" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted2Brush}"/>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <Button Content="Aceptar" Style="{StaticResource VibraPrimaryButton}"
                        Command="{Binding ViewModel.CloseAlertCommand}" Width="100"/>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

    </Grid>
</Page>
