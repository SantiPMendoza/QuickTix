<Page x:Class="QuickTix.Desktop.Views.Pages.UsersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:QuickTix.Desktop.Views.Pages"
      xmlns:controls="clr-namespace:QuickTix.Desktop.Controls"
      mc:Ignorable="d"
      Title="Administradores y Gestores">

    <!-- Rediseño visual Vibra (sistema 3b aplicado a Usuarios): bindings intactos -->
    <Grid Background="{StaticResource PageBgBrush}"
          TextElement.FontFamily="{StaticResource VibraBodyFontFamily}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Topbar de página -->
        <Border Grid.Row="0" Style="{StaticResource VibraTopBar}">
            <TextBlock Style="{StaticResource VibraPageTitle}" Text="Usuarios"/>
        </Border>

        <Grid Grid.Row="1" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- Administradores -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Style="{StaticResource VibraCard}" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource VibraCardTitle}" Text="Administradores" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+ Añadir"
                                    Style="{StaticResource VibraPrimaryPillButton}"
                                    Command="{Binding OpenAdminFlyoutCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Editar"
                                    Style="{StaticResource VibraSecondaryButton}"
                                    Command="{Binding EditAdminCommand}"
                                    IsEnabled="{Binding AdminsVM.SelectedItem, Converter={StaticResource NullToBoolConverter}}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Eliminar"
                                    Style="{StaticResource VibraDangerButton}"
                                    Command="{Binding AdminsVM.DeleteCommand}"
                                    CommandParameter="{Binding AdminsVM.SelectedItem.Id}"
                                    IsEnabled="{Binding AdminsVM.SelectedItem, Converter={StaticResource NullToBoolConverter}}" />
                        </StackPanel>
                    </Grid>

                    <ListView Style="{StaticResource VibraTableListView}"
                              ItemsSource="{Binding AdminsVM.Items}"
                              SelectedItem="{Binding AdminsVM.SelectedItem}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                <GridViewColumn Header="ID" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}"
                                                       FontFamily="{StaticResource VibraMonoFontFamily}"
                                                       FontSize="12.5"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="NOMBRE" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="EMAIL" Width="250" DisplayMemberBinding="{Binding Email}"/>
                                <GridViewColumn Header="NIF" Width="140" DisplayMemberBinding="{Binding Nif}"/>
                                <GridViewColumn Header="TELÉFONO" Width="140" DisplayMemberBinding="{Binding PhoneNumber}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- Gestores -->
            <!-- ============================================================ -->
            <Border Grid.Row="2" Style="{StaticResource VibraCard}" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource VibraCardTitle}" Text="Gestores" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+ Añadir"
                                    Style="{StaticResource VibraPrimaryPillButton}"
                                    Command="{Binding OpenManagerFlyoutCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Editar"
                                    Style="{StaticResource VibraSecondaryButton}"
                                    Command="{Binding EditManagerCommand}"
                                    IsEnabled="{Binding ManagersVM.SelectedItem, Converter={StaticResource NullToBoolConverter}}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Eliminar"
                                    Style="{StaticResource VibraDangerButton}"
                                    Command="{Binding ManagersVM.DeleteCommand}"
                                    CommandParameter="{Binding ManagersVM.SelectedItem.Id}"
                                    IsEnabled="{Binding ManagersVM.SelectedItem, Converter={StaticResource NullToBoolConverter}}" />
                        </StackPanel>
                    </Grid>

                    <ListView Style="{StaticResource VibraTableListView}"
                              ItemsSource="{Binding ManagersVM.Items}"
                              SelectedItem="{Binding ManagersVM.SelectedItem}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                <GridViewColumn Header="ID" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}"
                                                       FontFamily="{StaticResource VibraMonoFontFamily}"
                                                       FontSize="12.5"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="NOMBRE" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="EMAIL" Width="250" DisplayMemberBinding="{Binding Email}"/>
                                <GridViewColumn Header="RECINTO" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VenueName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="NIF" Width="140" DisplayMemberBinding="{Binding Nif}"/>
                                <GridViewColumn Header="TELÉFONO" Width="140" DisplayMemberBinding="{Binding PhoneNumber}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- Flyout Administrador (chrome común VibraDialog, fix 2b) -->
            <!-- ============================================================ -->
            <!-- RowSpan completo: el Popup se centra sobre este control,
                 así que debe ocupar toda la zona de contenido -->
            <controls:VibraDialog Grid.Row="0" Grid.RowSpan="3"
                                  IsOpen="{Binding IsAdminFlyoutOpen}"
                                  DialogMinWidth="400"
                                  Title="{Binding IsEditingAdmin,
                                          Converter={StaticResource BoolToTextConverter},
                                          ConverterParameter='Editar Administrador|Añadir Administrador'}"
                                  CloseCommand="{Binding CloseAdminFlyoutCommand}">
                <controls:VibraDialog.DialogContent>
                    <StackPanel>
                        <!-- Campos a ancho completo de la tarjeta (antes Width=250 fijo) -->
                        <Label Content="Nombre:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveAdminForm.Name, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <Label Content="NIF:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveAdminForm.Nif, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <Label Content="Email:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveAdminForm.Email, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <Label Content="Teléfono:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveAdminForm.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <TextBlock Text="{Binding AdminsVM.ErrorMessage}"
                                   Foreground="{StaticResource DangerFgBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding AdminsVM.ErrorMessage, Converter={StaticResource NullToCollapsedVisibilityConverter}}"/>
                    </StackPanel>
                </controls:VibraDialog.DialogContent>
                <controls:VibraDialog.Footer>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                                Command="{Binding CloseAdminFlyoutCommand}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Guardar" Style="{StaticResource VibraPrimaryButton}"
                                Command="{Binding SaveAdminCommand}" Width="100"/>
                    </StackPanel>
                </controls:VibraDialog.Footer>
            </controls:VibraDialog>

            <!-- ============================================================ -->
            <!-- Flyout Gestor (chrome común VibraDialog, fix 2b) -->
            <!-- ============================================================ -->
            <controls:VibraDialog Grid.Row="0" Grid.RowSpan="3"
                                  IsOpen="{Binding IsManagerFlyoutOpen}"
                                  DialogMinWidth="400"
                                  Title="{Binding IsEditingManager,
                                          Converter={StaticResource BoolToTextConverter},
                                          ConverterParameter='Editar Gestor|Añadir Gestor'}"
                                  CloseCommand="{Binding CloseManagerFlyoutCommand}">
                <controls:VibraDialog.DialogContent>
                    <StackPanel>
                        <Label Content="Nombre:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveManagerForm.Name, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <Label Content="NIF:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveManagerForm.Nif, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <Label Content="Email:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveManagerForm.Email, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <Label Content="Teléfono:" Style="{StaticResource VibraFieldLabel}"/>
                        <TextBox Text="{Binding ActiveManagerForm.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"/>

                        <Label Content="Recinto:" Style="{StaticResource VibraFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ManagersVM.Venues}"
                                  SelectedValue="{Binding ActiveManagerForm.VenueId, Mode=TwoWay}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Text="{Binding ManagersVM.ErrorMessage}"
                                   Foreground="{StaticResource DangerFgBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding ManagersVM.ErrorMessage, Converter={StaticResource NullToCollapsedVisibilityConverter}}"/>
                    </StackPanel>
                </controls:VibraDialog.DialogContent>
                <controls:VibraDialog.Footer>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                                Command="{Binding CloseManagerFlyoutCommand}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Guardar" Style="{StaticResource VibraPrimaryButton}"
                                Command="{Binding SaveManagerCommand}" Width="100"/>
                    </StackPanel>
                </controls:VibraDialog.Footer>
            </controls:VibraDialog>

        </Grid>
    </Grid>
</Page>
