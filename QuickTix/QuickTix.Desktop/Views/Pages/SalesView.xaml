<Page x:Class="QuickTix.Desktop.Views.Pages.SalesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:QuickTix.Desktop.Controls"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="1000"
      Title="SalesView">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <!-- Rediseño visual Vibra (spec 3b): bindings intactos -->
    <Grid Background="{StaticResource PageBgBrush}"
          TextElement.FontFamily="{StaticResource VibraBodyFontFamily}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Topbar de página -->
        <Border Grid.Row="0" Style="{StaticResource VibraTopBar}">
            <TextBlock Style="{StaticResource VibraPageTitle}" Text="Historial de ventas"/>
        </Border>

        <TabControl Grid.Row="1" Margin="24,18" Style="{StaticResource SegmentedTabControl}">

            <TabItem Header="Entradas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Recargar" Width="120"
                                Style="{StaticResource VibraSecondaryButton}"
                                Command="{Binding TicketSales.LoadCommand}" />
                        <!-- Anular: solo admin y solo sobre una venta no anulada seleccionada -->
                        <Button Content="Anular venta seleccionada" Width="200" Margin="10,0,0,0"
                                Style="{StaticResource VibraDangerButton}"
                                Visibility="{Binding TicketSales.IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding TicketSales.OpenVoidForSelectedCommand}" />
                    </StackPanel>

                    <!-- Tabla en tarjeta -->
                    <Border Grid.Row="1" Style="{StaticResource VibraCard}" Padding="10">
                        <ListView HorizontalContentAlignment="Stretch"
                                  MaxHeight="600"
                                  Style="{StaticResource VibraTableListView}"
                                  ItemsSource="{Binding TicketSales.Items}"
                                  SelectedItem="{Binding TicketSales.SelectedItem}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                    <GridViewColumn Header="ID" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}"
                                                           FontFamily="{StaticResource VibraMonoFontFamily}"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource InkBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ESTADO" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Badge «Anulada» (el motivo va en el tooltip) -->
                                                <Border Style="{StaticResource VibraDangerChip}"
                                                        ToolTip="{Binding VoidReason, StringFormat='Motivo: {0}'}"
                                                        Visibility="{Binding IsVoided, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Anulada"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="FECHA DE VENTA" Width="180"
                                        DisplayMemberBinding="{Binding Date, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"/>
                                    <GridViewColumn Header="DÍA SEMANA" Width="100" DisplayMemberBinding="{Binding DiaSemanaString}"/>
                                    <GridViewColumn Header="RECINTO" Width="190">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding VenueName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="VENDIDO POR" Width="150" DisplayMemberBinding="{Binding ManagerName}"/>
                                    <GridViewColumn Header="Nº ENTRADAS" Width="110" DisplayMemberBinding="{Binding Quantity}"/>
                                    <GridViewColumn Header="TOTAL" Width="140"
                                                    HeaderContainerStyle="{StaticResource VibraTableHeaderRight}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} €'}"
                                                           TextAlignment="Right"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource InkBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Detalle de la venta -->
                    <Border Grid.Row="2" Style="{StaticResource VibraCard}" Margin="0,12,0,0">
                        <Expander Header="Detalle de la venta"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource InkBrush}"
                                  IsExpanded="{Binding TicketSales.IsDetailVisible}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Margin="0,0,0,8"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource TextMuted2Brush}"
                                           Text="{Binding TicketSales.DetailHeader}" />

                                <ListView ItemsSource="{Binding TicketSales.DetailLines}"
                                          MaxHeight="220"
                                          Style="{StaticResource VibraTableListView}"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                            <GridViewColumn Header="TIPO" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Type}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource InkBrush}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="CONTEXTO" Width="150" DisplayMemberBinding="{Binding Context}"/>
                                            <GridViewColumn Header="CANTIDAD" Width="90" DisplayMemberBinding="{Binding Quantity}"/>
                                            <GridViewColumn Header="PRECIO" Width="110">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2} €'}"
                                                                   FontFamily="{StaticResource VibraMonoFontFamily}"
                                                                   FontSize="12.5"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="TOTAL" Width="110">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} €'}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InkBrush}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="INVITADO POR" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.TicketSales.InvitedByClientName, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Cerrar detalle"
                                            Width="140"
                                            Style="{StaticResource VibraSecondaryButton}"
                                            Command="{Binding TicketSales.CloseDetailCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Suscripciones">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Recargar" Width="120"
                                Style="{StaticResource VibraSecondaryButton}"
                                Command="{Binding SubscriptionSales.LoadCommand}" />
                        <!-- Anular: solo admin y solo sobre una venta no anulada seleccionada -->
                        <Button Content="Anular venta seleccionada" Width="200" Margin="10,0,0,0"
                                Style="{StaticResource VibraDangerButton}"
                                Visibility="{Binding SubscriptionSales.IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding SubscriptionSales.OpenVoidForSelectedCommand}" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource VibraCard}" Padding="10">
                        <ListView HorizontalContentAlignment="Stretch"
                                  MaxHeight="600"
                                  Style="{StaticResource VibraTableListView}"
                                  ItemsSource="{Binding SubscriptionSales.Items}"
                                  SelectedItem="{Binding SubscriptionSales.SelectedItem}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                    <GridViewColumn Header="ID" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}"
                                                           FontFamily="{StaticResource VibraMonoFontFamily}"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource InkBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ESTADO" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Badge «Anulada» (el motivo va en el tooltip) -->
                                                <Border Style="{StaticResource VibraDangerChip}"
                                                        ToolTip="{Binding VoidReason, StringFormat='Motivo: {0}'}"
                                                        Visibility="{Binding IsVoided, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Anulada"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="FECHA DE VENTA" Width="180"
                                                    DisplayMemberBinding="{Binding Date, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"/>
                                    <GridViewColumn Header="DÍA SEMANA" Width="100" DisplayMemberBinding="{Binding DiaSemanaString}"/>
                                    <GridViewColumn Header="RECINTO" Width="190">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding VenueName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="VENDIDO POR" Width="150" DisplayMemberBinding="{Binding ManagerName}"/>
                                    <GridViewColumn Header="CLIENTE" Width="220" DisplayMemberBinding="{Binding ClientName}"/>
                                    <GridViewColumn Header="CATEGORÍA" Width="160" DisplayMemberBinding="{Binding SubscriptionCategory}"/>
                                    <GridViewColumn Header="PRECIO" Width="110"
                                                    HeaderContainerStyle="{StaticResource VibraTableHeaderRight}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} €'}"
                                                           TextAlignment="Right"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource InkBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Avisos modales (sustituyen a los MessageBox de error de carga):
             uno por cada VM de historial -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding TicketSales.IsAlertOpen}"
                              DialogMinWidth="380"
                              Title="{Binding TicketSales.AlertTitle}">
            <controls:VibraDialog.DialogContent>
                <TextBlock Text="{Binding TicketSales.AlertMessage}"
                           MaxWidth="440" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted2Brush}"/>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <Button Content="Aceptar" Style="{StaticResource VibraPrimaryButton}"
                        Command="{Binding TicketSales.CloseAlertCommand}" Width="100"/>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding SubscriptionSales.IsAlertOpen}"
                              DialogMinWidth="380"
                              Title="{Binding SubscriptionSales.AlertTitle}">
            <controls:VibraDialog.DialogContent>
                <TextBlock Text="{Binding SubscriptionSales.AlertMessage}"
                           MaxWidth="440" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted2Brush}"/>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <Button Content="Aceptar" Style="{StaticResource VibraPrimaryButton}"
                        Command="{Binding SubscriptionSales.CloseAlertCommand}" Width="100"/>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <!-- Diálogo de anulación (TicketSales): motivo obligatorio, máx. 200 -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding TicketSales.IsVoidDialogOpen}"
                              DialogMinWidth="440"
                              Title="{Binding TicketSales.VoidDialogTitle}"
                              CloseCommand="{Binding TicketSales.CloseVoidDialogCommand}">
            <controls:VibraDialog.DialogContent>
                <StackPanel MaxWidth="480">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted2Brush}"
                               Text="La venta no se borra: queda marcada como anulada y deja de contar en el cierre de caja y en el Panel. Esta acción no se puede deshacer."/>

                    <Label Content="Motivo de la anulación:" Style="{StaticResource VibraFieldLabel}"/>
                    <TextBox Text="{Binding TicketSales.VoidReason, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             MinHeight="70"
                             VerticalContentAlignment="Top"/>
                    <TextBlock Text="{Binding TicketSales.VoidReasonCounter}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>

                    <TextBlock Text="{Binding TicketSales.VoidError}"
                               Foreground="{StaticResource DangerFgBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="{Binding TicketSales.VoidError, Converter={StaticResource NullToCollapsedVisibilityConverter}}"/>
                </StackPanel>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                            Command="{Binding TicketSales.CloseVoidDialogCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Anular venta" Style="{StaticResource VibraDangerButton}"
                            Command="{Binding TicketSales.ConfirmVoidCommand}" Width="130"/>
                </StackPanel>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <!-- Diálogo de anulación (SubscriptionSales): motivo obligatorio, máx. 200 -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding SubscriptionSales.IsVoidDialogOpen}"
                              DialogMinWidth="440"
                              Title="{Binding SubscriptionSales.VoidDialogTitle}"
                              CloseCommand="{Binding SubscriptionSales.CloseVoidDialogCommand}">
            <controls:VibraDialog.DialogContent>
                <StackPanel MaxWidth="480">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted2Brush}"
                               Text="La venta no se borra: queda marcada como anulada y deja de contar en el cierre de caja y en el Panel. Esta acción no se puede deshacer."/>

                    <Label Content="Motivo de la anulación:" Style="{StaticResource VibraFieldLabel}"/>
                    <TextBox Text="{Binding SubscriptionSales.VoidReason, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             MinHeight="70"
                             VerticalContentAlignment="Top"/>
                    <TextBlock Text="{Binding SubscriptionSales.VoidReasonCounter}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>

                    <TextBlock Text="{Binding SubscriptionSales.VoidError}"
                               Foreground="{StaticResource DangerFgBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="{Binding SubscriptionSales.VoidError, Converter={StaticResource NullToCollapsedVisibilityConverter}}"/>
                </StackPanel>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                            Command="{Binding SubscriptionSales.CloseVoidDialogCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Anular venta" Style="{StaticResource VibraDangerButton}"
                            Command="{Binding SubscriptionSales.ConfirmVoidCommand}" Width="130"/>
                </StackPanel>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>
    </Grid>
</Page>
