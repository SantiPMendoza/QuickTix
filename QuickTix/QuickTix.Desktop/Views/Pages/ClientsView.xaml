<Page x:Class="QuickTix.Desktop.Views.Pages.ClientsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:QuickTix.Desktop.Views.Pages"
      xmlns:controls="clr-namespace:QuickTix.Desktop.Controls"
      mc:Ignorable="d"
      Title="Clientes">

    <Page.Resources>
        <!-- Fila de cliente (lista izquierda, 3c) -->
        <Style x:Key="VibraClientRow" TargetType="{x:Type ListViewItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipBlueBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Rediseño visual Vibra (spec 3c): bindings intactos -->
    <Grid Background="{StaticResource PageBgBrush}"
          TextElement.FontFamily="{StaticResource VibraBodyFontFamily}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Topbar de página -->
        <Border Grid.Row="0" Style="{StaticResource VibraTopBar}">
            <TextBlock Style="{StaticResource VibraPageTitle}" Text="Clientes"/>
        </Border>

        <Grid Grid.Row="1" Margin="24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- Izquierda: lista de clientes (340px, superficie blanca)      -->
            <!-- ============================================================ -->
            <Border Grid.Column="0" Style="{StaticResource VibraCard}" Margin="0,0,14,0" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource VibraCardTitle}" Text="Clientes" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Añadir"
                                Style="{StaticResource VibraPrimaryPillButton}"
                                Command="{Binding OpenClientFlyoutCommand}"/>
                    </Grid>
                    <!-- Buscador de la spec omitido: el VM no expone propiedad de filtro -->

                    <ListView ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}"
                              Style="{StaticResource VibraPlainListView}"
                              ItemContainerStyle="{StaticResource VibraClientRow}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AvatarBg" Width="38" Height="38" CornerRadius="11"
                                            Background="{StaticResource DisabledBgBrush}">
                                        <TextBlock x:Name="AvatarText"
                                                   Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                   FontFamily="{StaticResource VibraDisplayFontFamily}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted2Brush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PhoneNumber}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Avatar con degradado de marca solo en el seleccionado -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                        <Setter TargetName="AvatarBg" Property="Background" Value="{StaticResource AvatarGradient}"/>
                                        <Setter TargetName="AvatarText" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- Derecha: detalle del cliente                                  -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tarjeta cabecera: avatar 64 + datos + acciones -->
                <Border Grid.Row="0" Style="{StaticResource VibraCard}" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <!-- Mensaje cuando no hay selección -->
                        <TextBlock Text="Seleccione un cliente para ver sus abonos y entradas."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <Grid Visibility="{Binding SelectedItem, Converter={StaticResource NullToCollapsedVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="64" Height="64" CornerRadius="18"
                                    Background="{StaticResource AvatarGradient}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedItem.Name, Converter={StaticResource InitialsConverter}}"
                                           FontFamily="{StaticResource VibraDisplayFontFamily}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.Name}"
                                           FontFamily="{StaticResource VibraDisplayFontFamily}"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SelectedItem.Email}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedItem.Nif}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedItem.PhoneNumber}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Editar"
                                        Style="{StaticResource VibraSecondaryButton}"
                                        Command="{Binding EditClientCommand}"
                                        IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Eliminar"
                                        Style="{StaticResource VibraDangerButton}"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedItem.Id}"
                                        IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pestañas segmentadas -->
                <TabControl Grid.Row="1"
                            Style="{StaticResource SegmentedTabControl}"
                            IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}">
                    <!-- Abonos -->
                    <TabItem Header="Abonos">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Vender abono"
                                        Style="{StaticResource VibraPrimaryButton}"
                                        Effect="{StaticResource ActionShadow}"
                                        Command="{Binding OpenSubscriptionFlyoutCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Cancelar abono"
                                        Style="{StaticResource VibraDangerButton}"
                                        Command="{Binding CancelSubscriptionCommand}"
                                        IsEnabled="{Binding SubscriptionsVM.SelectedItem, Converter={StaticResource NullToBoolConverter}}" />
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource VibraCard}" Padding="10">
                                <ListView Style="{StaticResource VibraTableListView}"
                                          ItemsSource="{Binding SubscriptionsVM.Items}"
                                          SelectedItem="{Binding SubscriptionsVM.SelectedItem}">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource VibraTableHeader}">
                                            <GridViewColumn Header="ID" Width="55">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Id}"
                                                                   FontFamily="{StaticResource VibraMonoFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource InkBrush}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="CATEGORÍA" Width="140">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- Chip por categoría: cada SubscriptionCategory con su
                                                             familia de color Vibra; caducado degrada a gris
                                                             (coherente con ExpiredBg en Mobile). Fix 2b. -->
                                                        <Border x:Name="CategoryChip" HorizontalAlignment="Left"
                                                                CornerRadius="{StaticResource ChipCornerRadiusSmall}"
                                                                Padding="10,3"
                                                                Background="{StaticResource ChipTealBgBrush}">
                                                            <TextBlock x:Name="CategoryChipText"
                                                                       Text="{Binding Category}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ChipTealFgBrush}"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="Niño">
                                                                <Setter TargetName="CategoryChip" Property="Background" Value="{StaticResource ChipSkyBgBrush}"/>
                                                                <Setter TargetName="CategoryChipText" Property="Foreground" Value="{StaticResource ChipSkyFgBrush}"/>
                                                            </DataTrigger>
                                                            <!-- Adulto usa el teal por defecto del chip -->
                                                            <DataTrigger Binding="{Binding Category}" Value="Jubilado">
                                                                <Setter TargetName="CategoryChip" Property="Background" Value="{StaticResource ChipLavBgBrush}"/>
                                                                <Setter TargetName="CategoryChipText" Property="Foreground" Value="{StaticResource ChipLavFgBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="FamiliaNumerosa">
                                                                <Setter TargetName="CategoryChip" Property="Background" Value="{StaticResource ChipBlueBgBrush}"/>
                                                                <Setter TargetName="CategoryChipText" Property="Foreground" Value="{StaticResource ChipBlueFgBrush}"/>
                                                            </DataTrigger>
                                                            <!-- El gris de caducado va el ÚLTIMO para ganar a los
                                                                 triggers de categoría (misma propiedad) -->
                                                            <DataTrigger Binding="{Binding Status}" Value="Caducado">
                                                                <Setter TargetName="CategoryChip" Property="Background" Value="{StaticResource ExpiredBgBrush}"/>
                                                                <Setter TargetName="CategoryChipText" Property="Foreground" Value="{StaticResource ExpiredFgBrush}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="DURACIÓN" Width="100" DisplayMemberBinding="{Binding Duration}"/>
                                            <GridViewColumn Header="INICIO" Width="100"
                                                            DisplayMemberBinding="{Binding StartDate, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                            <GridViewColumn Header="FIN" Width="100"
                                                            DisplayMemberBinding="{Binding EndDate, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                            <GridViewColumn Header="PRECIO" Width="90">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} €'}"
                                                                   FontFamily="{StaticResource VibraMonoFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource InkBrush}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="ESTADO" Width="110">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- Chip de estado: Activo=teal, Caducado=gris -->
                                                        <Border x:Name="Chip" HorizontalAlignment="Left"
                                                                CornerRadius="{StaticResource ChipCornerRadiusSmall}"
                                                                Padding="10,3"
                                                                Background="{StaticResource ChipTealBgBrush}">
                                                            <TextBlock x:Name="ChipText"
                                                                       Text="{Binding Status}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ChipTealFgBrush}"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Caducado">
                                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ExpiredBgBrush}"/>
                                                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource ExpiredFgBrush}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Entradas (placeholder) -->
                    <TabItem Header="Entradas">
                        <Border Style="{StaticResource VibraCard}">
                            <TextBlock Text="Pendiente de implementar"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </TabItem>

                    <TabItem Header="Relacionados">
                        <Border Style="{StaticResource VibraCard}">
                            <TextBlock Text="Pendiente de implementar"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- Popups -->
        <!-- ============================================================ -->

        <!-- Popup Cliente (chrome común VibraDialog, fix 2b).
             RowSpan completo: el Popup se centra sobre este control. -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding IsClientFlyoutOpen}"
                              DialogMinWidth="420"
                              Title="{Binding IsEditingClient,
                                      Converter={StaticResource BoolToTextConverter},
                                      ConverterParameter='Editar Cliente|Añadir Cliente'}"
                              CloseCommand="{Binding CloseClientFlyoutCommand}">
            <controls:VibraDialog.DialogContent>
                <StackPanel>
                    <!-- Campos a ancho completo de la tarjeta (antes Width=280 fijo) -->
                    <Label Content="Nombre:" Style="{StaticResource VibraFieldLabel}"/>
                    <TextBox Text="{Binding ActiveClientForm.Name, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"/>

                    <Label Content="NIF:" Style="{StaticResource VibraFieldLabel}"/>
                    <TextBox Text="{Binding ActiveClientForm.Nif, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"/>

                    <Label Content="Email:" Style="{StaticResource VibraFieldLabel}"/>
                    <TextBox Text="{Binding ActiveClientForm.Email, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"/>

                    <Label Content="Teléfono:" Style="{StaticResource VibraFieldLabel}"/>
                    <TextBox Text="{Binding ActiveClientForm.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerFgBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedVisibilityConverter}}"/>
                </StackPanel>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                            Command="{Binding CloseClientFlyoutCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Guardar" Style="{StaticResource VibraPrimaryButton}"
                            Command="{Binding SaveClientCommand}" Width="100"/>
                </StackPanel>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <!-- Popup Abono (chrome común VibraDialog, fix 2b) -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding IsSubscriptionFlyoutOpen}"
                              DialogMinWidth="460"
                              Title="{Binding IsEditingSubscription,
                                      Converter={StaticResource BoolToTextConverter},
                                      ConverterParameter='Editar abono|Vender abono'}"
                              CloseCommand="{Binding CloseSubscriptionFlyoutCommand}">
            <controls:VibraDialog.DialogContent>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedItem.Name}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted2Brush}"
                               Margin="0,0,0,10"/>

                    <Label Content="Recinto:" Style="{StaticResource VibraFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding SubscriptionsVM.Venues}"
                              SelectedValue="{Binding ActiveSubscriptionForm.VenueId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              HorizontalAlignment="Stretch"/>

                    <Label Content="Categoría:" Style="{StaticResource VibraFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding SubscriptionsVM.Categories}"
                              SelectedItem="{Binding ActiveSubscriptionForm.Category, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>

                    <Label Content="Duración:" Style="{StaticResource VibraFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding SubscriptionsVM.Durations}"
                              SelectedItem="{Binding ActiveSubscriptionForm.Duration, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>

                    <!-- Fechas y precio se mantienen estrechos a propósito:
                         son valores cortos, a ancho completo parecerían campos de texto -->
                    <Label Content="Fecha de inicio:" Style="{StaticResource VibraFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ActiveSubscriptionForm.StartDate, Mode=TwoWay}"
                                Width="200" HorizontalAlignment="Left"/>

                    <Label Content="Fecha de fin (calculada):" Style="{StaticResource VibraFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ActiveSubscriptionForm.EndDate}"
                                Width="200" HorizontalAlignment="Left"
                                IsEnabled="False"/>

                    <Label Content="Precio (calculado):" Style="{StaticResource VibraFieldLabel}"/>
                    <TextBox Text="{Binding ActiveSubscriptionForm.Price}"
                             FontFamily="{StaticResource VibraMonoFontFamily}"
                             Width="120" HorizontalAlignment="Left"
                             IsReadOnly="True"/>

                    <TextBlock Text="{Binding SubscriptionsVM.ErrorMessage}"
                               Foreground="{StaticResource DangerFgBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="{Binding SubscriptionsVM.ErrorMessage, Converter={StaticResource NullToCollapsedVisibilityConverter}}"/>
                </StackPanel>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                            Command="{Binding CloseSubscriptionFlyoutCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Guardar" Style="{StaticResource VibraPrimaryButton}"
                            Command="{Binding SaveSubscriptionCommand}" Width="100"/>
                </StackPanel>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <!-- Confirmación de borrado de abono (fix 2b): sustituye al borrado
             directo sin pregunta. MVVM puro: el delete real solo corre en
             ConfirmDeleteSubscriptionCommand. -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding IsConfirmDeleteSubscriptionOpen}"
                              DialogMinWidth="420"
                              Title="¿Eliminar el abono?">
            <controls:VibraDialog.DialogContent>
                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted2Brush}">
                        <Run Text="Se eliminará el abono"/>
                        <Run Text="{Binding PendingDeleteSubscription.Category, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="("/><Run Text="{Binding PendingDeleteSubscription.Duration, Mode=OneWay}"/><Run Text=")"/>
                        <Run Text="válido hasta el"/>
                        <Run Text="{Binding PendingDeleteSubscription.EndDate, Mode=OneWay, StringFormat=dd/MM/yyyy}" FontWeight="SemiBold"/><Run Text="."/>
                        <Run Text="Esta acción no se puede deshacer."/>
                    </TextBlock>
                </StackPanel>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                            Command="{Binding CancelDeleteSubscriptionCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Eliminar" Style="{StaticResource VibraDangerButton}"
                            Command="{Binding ConfirmDeleteSubscriptionCommand}" Width="100"/>
                </StackPanel>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <!-- Borrado forzado de abono: SOLO aparece si la API devolvió 409
             (dependencias de venta). Sustituye al MessageBox que provocaba
             el "segundo diálogo" tras la confirmación. -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding IsForceDeleteSubscriptionOpen}"
                              DialogMinWidth="420"
                              Title="El abono tiene ventas asociadas">
            <controls:VibraDialog.DialogContent>
                <StackPanel MaxWidth="440">
                    <TextBlock Text="{Binding ForceDeleteSubscriptionMessage}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted2Brush}"/>
                    <TextBlock Text="Si continúas, se eliminará el abono y también los ítems de venta asociados. Esta acción no se puede deshacer."
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource TextMuted2Brush}"/>
                </StackPanel>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                            Command="{Binding CancelForceDeleteSubscriptionCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Eliminar todo" Style="{StaticResource VibraDangerButton}"
                            Command="{Binding ConfirmForceDeleteSubscriptionCommand}" Width="120"/>
                </StackPanel>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <!-- Confirmación de borrado de cliente (flujo genérico del
             BaseCrudViewModel: DeleteCommand abre este diálogo) -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding IsConfirmDeleteOpen}"
                              DialogMinWidth="420"
                              Title="¿Eliminar el cliente?">
            <controls:VibraDialog.DialogContent>
                <TextBlock MaxWidth="440" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted2Brush}">
                    <Run Text="Se eliminará el cliente"/>
                    <Run Text="{Binding PendingDeleteItem.Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="."/>
                    <Run Text="Esta acción no se puede deshacer."/>
                </TextBlock>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource VibraSecondaryButton}"
                            Command="{Binding CancelDeleteCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Eliminar" Style="{StaticResource VibraDangerButton}"
                            Command="{Binding ConfirmDeleteCommand}" Width="100"/>
                </StackPanel>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <!-- Avisos modales (sustituyen a los MessageBox): uno por VM anfitrión -->
        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding IsAlertOpen}"
                              DialogMinWidth="380"
                              Title="{Binding AlertTitle}">
            <controls:VibraDialog.DialogContent>
                <TextBlock Text="{Binding AlertMessage}"
                           MaxWidth="440" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted2Brush}"/>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <Button Content="Aceptar" Style="{StaticResource VibraPrimaryButton}"
                        Command="{Binding CloseAlertCommand}" Width="100"/>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

        <controls:VibraDialog Grid.Row="0" Grid.RowSpan="2"
                              IsOpen="{Binding SubscriptionsVM.IsAlertOpen}"
                              DialogMinWidth="380"
                              Title="{Binding SubscriptionsVM.AlertTitle}">
            <controls:VibraDialog.DialogContent>
                <TextBlock Text="{Binding SubscriptionsVM.AlertMessage}"
                           MaxWidth="440" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted2Brush}"/>
            </controls:VibraDialog.DialogContent>
            <controls:VibraDialog.Footer>
                <Button Content="Aceptar" Style="{StaticResource VibraPrimaryButton}"
                        Command="{Binding SubscriptionsVM.CloseAlertCommand}" Width="100"/>
            </controls:VibraDialog.Footer>
        </controls:VibraDialog>

    </Grid>
</Page>
