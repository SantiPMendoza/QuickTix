<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Tema "1b Vibra" (escritorio) — tokens del handoff de diseño
         (reference/App redesign directions/design_handoff_quicktix_vibra).
         Solo define recursos con clave: NINGÚN estilo implícito.
         Las vistas los consumirán en los bloques de restyling.
         ============================================================ -->

    <!-- ===== Colores: marca ===== -->
    <Color x:Key="BrandTeal">#60E0CF</Color>
    <Color x:Key="BrandTealDeep">#3CC9C0</Color>
    <Color x:Key="BrandCyan">#60C7E0</Color>
    <Color x:Key="BrandPeriwinkle">#7C9BF7</Color>
    <Color x:Key="BrandLavender">#CCAFEB</Color>
    <Color x:Key="BrandSky">#ABD6FF</Color>

    <!-- ===== Colores: texto ===== -->
    <Color x:Key="Ink">#14233B</Color>
    <Color x:Key="InkSidebar">#0F1B33</Color>
    <Color x:Key="TitleBar">#14233B</Color>
    <Color x:Key="TextMuted">#8393AC</Color>
    <Color x:Key="TextMuted2">#4A5163</Color>

    <!-- ===== Colores: fondos y superficies ===== -->
    <Color x:Key="PageBg">#F2F6FF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#FAFCFF</Color>
    <Color x:Key="TableHeadBg">#F7F9FE</Color>
    <Color x:Key="Border">#E7ECF7</Color>
    <Color x:Key="BorderStrong">#DCE6FF</Color>

    <!-- ===== Colores: chips ===== -->
    <Color x:Key="ChipBlueBg">#EEF3FF</Color>
    <Color x:Key="ChipBlueFg">#4E67C7</Color>
    <Color x:Key="ChipTealBg">#EAFBF8</Color>
    <Color x:Key="ChipTealFg">#0F8C82</Color>
    <Color x:Key="ChipLavBg">#F4F1FC</Color>
    <Color x:Key="ChipLavFg">#7A5CB0</Color>

    <!-- ===== Colores: estados ===== -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessBg">#EAFBF8</Color>
    <Color x:Key="DangerBg">#F1EAF0</Color>
    <Color x:Key="DangerFg">#B0447A</Color>
    <Color x:Key="ExpiredBg">#F1F0F3</Color>
    <Color x:Key="ExpiredFg">#9098A8</Color>
    <Color x:Key="ExpiredCard1">#B4BAC4</Color>
    <Color x:Key="ExpiredCard2">#9CA3AF</Color>
    <!-- Botón deshabilitado (sección Interactions del handoff) -->
    <Color x:Key="DisabledBg">#EEF0F6</Color>
    <Color x:Key="DisabledText">#8393AC</Color>
    <!-- Texto de ítem inactivo del sidebar -->
    <Color x:Key="SidebarInactiveText">#AEB8CC</Color>

    <!-- ===== Brushes sólidos ===== -->
    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTeal}" />
    <SolidColorBrush x:Key="BrandTealDeepBrush" Color="{StaticResource BrandTealDeep}" />
    <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyan}" />
    <SolidColorBrush x:Key="BrandPeriwinkleBrush" Color="{StaticResource BrandPeriwinkle}" />
    <SolidColorBrush x:Key="BrandLavenderBrush" Color="{StaticResource BrandLavender}" />
    <SolidColorBrush x:Key="BrandSkyBrush" Color="{StaticResource BrandSky}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="InkSidebarBrush" Color="{StaticResource InkSidebar}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBar}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextMuted2Brush" Color="{StaticResource TextMuted2}" />
    <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}" />
    <SolidColorBrush x:Key="TableHeadBgBrush" Color="{StaticResource TableHeadBg}" />
    <SolidColorBrush x:Key="VibraBorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="ChipBlueBgBrush" Color="{StaticResource ChipBlueBg}" />
    <SolidColorBrush x:Key="ChipBlueFgBrush" Color="{StaticResource ChipBlueFg}" />
    <SolidColorBrush x:Key="ChipTealBgBrush" Color="{StaticResource ChipTealBg}" />
    <SolidColorBrush x:Key="ChipTealFgBrush" Color="{StaticResource ChipTealFg}" />
    <SolidColorBrush x:Key="ChipLavBgBrush" Color="{StaticResource ChipLavBg}" />
    <SolidColorBrush x:Key="ChipLavFgBrush" Color="{StaticResource ChipLavFg}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBg}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBg}" />
    <SolidColorBrush x:Key="DangerFgBrush" Color="{StaticResource DangerFg}" />
    <SolidColorBrush x:Key="ExpiredBgBrush" Color="{StaticResource ExpiredBg}" />
    <SolidColorBrush x:Key="ExpiredFgBrush" Color="{StaticResource ExpiredFg}" />
    <SolidColorBrush x:Key="DisabledBgBrush" Color="{StaticResource DisabledBg}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledText}" />
    <SolidColorBrush x:Key="SidebarInactiveTextBrush" Color="{StaticResource SidebarInactiveText}" />

    <!-- ===== Degradados =====
         Conversión de ángulos CSS: 90deg = horizontal izq→der;
         150deg ≈ diagonal desde arriba-izquierda (vector 0.5,0.866). -->
    <LinearGradientBrush x:Key="ActionGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BrandTealDeep}" Offset="0" />
        <GradientStop Color="{StaticResource BrandCyan}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActionGradientAlt" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="0" />
        <GradientStop Color="{StaticResource BrandCyan}" Offset="1" />
    </LinearGradientBrush>

    <!-- Hover: degradados de acción oscurecidos ~7% (sección Interactions) -->
    <LinearGradientBrush x:Key="ActionGradientHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#38BBB3" Offset="0" />
        <GradientStop Color="#59B9D0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActionGradientAltHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#7390E6" Offset="0" />
        <GradientStop Color="#59B9D0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource BrandTeal}" Offset="0" />
        <GradientStop Color="{StaticResource BrandCyan}" Offset="0.45" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource BrandTeal}" Offset="0" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ChipNewGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BrandTealDeep}" Offset="0" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ExpiredCardGradient" StartPoint="0,0" EndPoint="0.58,1">
        <GradientStop Color="{StaticResource ExpiredCard1}" Offset="0" />
        <GradientStop Color="{StaticResource ExpiredCard2}" Offset="1" />
    </LinearGradientBrush>

    <!-- Ítem activo del sidebar (shell escritorio) -->
    <LinearGradientBrush x:Key="SidebarActiveGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#3860C7E0" Offset="0" />
        <GradientStop Color="#247C9BF7" Offset="1" />
    </LinearGradientBrush>

    <!-- Barra izquierda del ítem activo del sidebar (vertical) -->
    <LinearGradientBrush x:Key="SidebarActiveBarGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource BrandTeal}" Offset="0" />
        <GradientStop Color="{StaticResource BrandPeriwinkle}" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Tipografía =====
         Fuentes empaquetadas como Resource en /Fonts. Family names
         internos verificados en los TTF: "Space Grotesk" (SemiBold/Bold),
         "DM Sans" (Regular/Medium/SemiBold/Bold), "IBM Plex Mono"
         (Medium/SemiBold). El peso se selecciona con FontWeight. -->
    <FontFamily x:Key="VibraDisplayFontFamily">pack://application:,,,/Fonts/#Space Grotesk, Segoe UI</FontFamily>
    <FontFamily x:Key="VibraBodyFontFamily">pack://application:,,,/Fonts/#DM Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="VibraMonoFontFamily">pack://application:,,,/Fonts/#IBM Plex Mono, Consolas</FontFamily>

    <!-- ===== Radios (escala escritorio del handoff) ===== -->
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusLarge">18</CornerRadius>
    <CornerRadius x:Key="KpiCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadiusSmall">10</CornerRadius>

    <!-- ===== Sombras de color (aprox. de las box-shadow del handoff) ===== -->
    <DropShadowEffect x:Key="CardShadow" Color="#6096E0" Direction="270"
                      ShadowDepth="6" BlurRadius="16" Opacity="0.07" />
    <DropShadowEffect x:Key="ElevatedShadow" Color="#7C9BF7" Direction="270"
                      ShadowDepth="10" BlurRadius="26" Opacity="0.4" />
    <DropShadowEffect x:Key="ActionShadow" Color="#3CC7C0" Direction="270"
                      ShadowDepth="8" BlurRadius="16" Opacity="0.35" />
    <DropShadowEffect x:Key="ActionShadowAlt" Color="#7C9BF7" Direction="270"
                      ShadowDepth="10" BlurRadius="20" Opacity="0.4" />

    <!-- ============================================================
         Estilos base reutilizables (con clave; las vistas se
         reestilizan en bloques posteriores).
         ============================================================ -->

    <!-- Tarjeta estándar -->
    <Style x:Key="VibraCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VibraBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- Botón primario: degradado teal→cyan, texto blanco -->
    <Style x:Key="VibraPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ActionGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource VibraBodyFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActionGradientHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBgBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón secundario: superficie blanca con borde -->
    <Style x:Key="VibraSecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource VibraBodyFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource VibraBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBgBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón destructivo suave (Rechazar/Eliminar) -->
    <Style x:Key="VibraDangerButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerFgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource VibraBodyFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- DangerBg oscurecido ~5% -->
                            <Setter TargetName="Bd" Property="Background" Value="#E5DEE4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBgBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip (pill). Fondo/texto por defecto: chip informativo azul;
         cambiar Background/TextElement.Foreground al usarlo -->
    <Style x:Key="VibraChip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ChipBlueBgBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ChipCornerRadius}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ChipBlueFgBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource VibraBodyFontFamily}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.FontSize" Value="11" />
    </Style>

</ResourceDictionary>
